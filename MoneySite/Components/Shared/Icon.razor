@* A 24×24 line icon from a single SVG path. *@
<svg class="ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round"><path d="@Path" /></svg>

@code {
    [Parameter, EditorRequired] public string Path { get; set; } = "";
}
