@* Single-series line chart rendered as SVG, with gridlines, axis labels and a hover readout (see app.js). *@

<div class="chart-wrap">
    <svg class="linechart" viewBox="0 0 @W @H" role="img"
         aria-label="@AriaLabel" data-points="@_json">
        @foreach (var t in _yTicks)
        {
            <line class="grid @(t.Value == 0 ? "zero" : "")" x1="@L" x2="@(W - R)" y1="@F(t.Y)" y2="@F(t.Y)" />
        }
        @* Razor reserves <text>, so the SVG labels are emitted as markup. *@
        @((MarkupString)AxisLabels())
        <path class="area" d="@_area" />
        <polyline class="line" points="@_line" />
        <g class="hover" style="display:none">
            <line class="crosshair" y1="@T" y2="@(H - B)" />
            <circle r="4.5" />
        </g>
    </svg>
    <div class="tip"><b></b><span></span></div>
</div>

@code {
    [Parameter, EditorRequired] public List<ChartPoint> Points { get; set; } = new();
    [Parameter] public string AriaLabel { get; set; } = "Line chart";
    [Parameter] public int H { get; set; } = 280;
    /// false = fit the axis to the data instead of starting at $0, so small changes on a
    /// large total (e.g. net worth) are visible.
    [Parameter] public bool ZeroBased { get; set; } = true;

    private const double W = 900, L = 72, R = 12, T = 12, B = 28;
    private string _line = "", _area = "", _json = "[]";
    private List<(double Y, decimal Value, string Label)> _yTicks = new();
    private List<(double X, string Label)> _xTicks = new();

    protected override void OnParametersSet()
    {
        var pts = Points;
        if (pts.Count < 2) return;

        var min = pts.Min(p => p.Value);
        var max = pts.Max(p => p.Value);
        if (ZeroBased) { min = Math.Min(0, min); max = Math.Max(0, max); }
        else
        {
            // Leave some room above and below the line.
            var pad = Math.Max((max - min) * 0.15m, Math.Abs(max) * 0.01m);
            min -= pad; max += pad;
        }
        if (max == min) max = min + 100;
        var step = NiceStep((max - min) / 4);
        var lo = Math.Floor(min / step) * step;
        var hi = Math.Ceiling(max / step) * step;

        double X(int i) => L + i * (W - L - R) / (pts.Count - 1);
        double Y(decimal v) => T + (double)((hi - v) / (hi - lo)) * (H - T - B);

        _yTicks = new();
        for (var v = lo; v <= hi; v += step) _yTicks.Add((Y(v), v, Money.Short(v)));

        var span = (pts[^1].Date - pts[0].Date).TotalDays;
        string Fmt(DateTime d) => span > 400 ? d.ToString("MMM yy") : d.ToString("MMM d");
        var every = Math.Max(1, (int)Math.Ceiling(pts.Count / 7.0));
        _xTicks = Enumerable.Range(0, pts.Count).Where(i => (pts.Count - 1 - i) % every == 0)
            .Select(i => (X(i), Fmt(pts[i].Date))).ToList();

        _line = string.Join(" ", pts.Select((p, i) => $"{F(X(i))},{F(Y(p.Value))}"));
        var baseY = ZeroBased ? Y(0) : Y(lo);   // fill down to $0, or to the bottom of a fitted axis
        _area = $"M{F(X(0))},{F(baseY)} L" + _line.Replace(" ", " L") + $" L{F(X(pts.Count - 1))},{F(baseY)} Z";
        _json = System.Text.Json.JsonSerializer.Serialize(pts.Select((p, i) => new
        {
            x = Math.Round(X(i), 1),
            y = Math.Round(Y(p.Value), 1),
            label = p.Date.ToString("MMM d, yyyy"),
            value = Money.Whole(p.Value)
        }));
    }

    private string AxisLabels()
    {
        var sb = new System.Text.StringBuilder();
        string E(string s) => System.Net.WebUtility.HtmlEncode(s);
        // "alt" labels (every other one) are hidden on phones, where they would crowd.
        foreach (var (t, i) in _yTicks.Select((t, i) => (t, i)))
            sb.Append($"<text class=\"axis{(i % 2 == 1 ? " alt" : "")}\" x=\"{F(L - 8)}\" y=\"{F(t.Y + 4)}\" text-anchor=\"end\">{E(t.Label)}</text>");
        foreach (var t in _xTicks)
            sb.Append($"<text class=\"axis\" x=\"{F(t.X)}\" y=\"{F(H - 6)}\" text-anchor=\"middle\">{E(t.Label)}</text>");
        return sb.ToString();
    }

    private static decimal NiceStep(decimal rough)
    {
        if (rough <= 0) return 1;
        var mag = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)rough)));
        var n = rough / mag;
        return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5m ? 2.5m : n <= 5 ? 5 : 10) * mag;
    }

    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
