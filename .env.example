# Copy this file to .env and fill in your own values. Never commit .env.
# Use the SAME Plaid keys and environment the local app uses, or the access tokens
# already stored in money.db will be rejected and every bank will need re-linking.

Plaid__ClientID=your-plaid-client-id
Plaid__ClientSecret=your-plaid-secret
# sandbox | production ("trial" is treated as production)
Plaid__Environment=production

# Containers run in UTC by default. The app uses the local date for "today",
# daily balance snapshots and month boundaries, so set your own time zone.
TZ=America/New_York
